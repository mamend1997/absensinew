NODE_ENV=development
HOST=127.0.0.1
PORT=4100
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=absensi_saas
MYSQL_USER=absensi_saas
MYSQL_PASSWORD=replace-with-a-private-database-password
MYSQL_CONNECTION_LIMIT=10
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_TTL=8h
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,https://localhost
PUBLIC_WEB_URL=https://your-school-portal.example
PUBLIC_API_URL=https://your-saas-api.example
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_ENVIRONMENT=sandbox
# Set to a persistent private volume mount (for example /data/backups).
BACKUP_DIRECTORY=
BACKUP_TIMEZONE=Asia/Jakarta
