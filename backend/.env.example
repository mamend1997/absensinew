PORT=3000
NODE_ENV=development
DB_DRIVER=sqlite
SQLITE_PATH=./data/absensi.sqlite

# Set DB_DRIVER=mysql to use the MySQL connection pool.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=absensi
MYSQL_USER=absensi_app
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10

# Generate a random secret; replace this example before starting the API.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
APP_TIMEZONE=Asia/Jakarta
WEB_ORIGIN=http://localhost:5173,https://localhost,capacitor://localhost
